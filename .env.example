# Native mode uses persistent PGlite when DATABASE_URL is empty.
DATABASE_URL=
# Supabase: copy its Direct or Session pooler PostgreSQL URL (port 5432).
# The backend automatically uses the private "infrared" schema and verified TLS.
# Keep this server-side. Never use a VITE_ variable or an anon key for database access.
DATABASE_SCHEMA=
DATABASE_POOL_SIZE=
# Optional path to the Supabase root CA certificate downloaded from Database settings.
DATABASE_SSL_CA_FILE=
DATA_DIR=.local
# Local access only by default; use an IP address when changing the listener.
BIND_HOST=127.0.0.1
# Optional local SASRec/EulerNet runtime. Install apps/intelligence/requirements.txt in this environment.
# Windows example: .local/intelligence-venv/Scripts/python.exe
# Empty detects .local/intelligence-venv automatically, then falls back to python.
INFRARED_INTELLIGENCE_PYTHON=
DASHBOARD_PORT=3000
COLLECTOR_PORT=8080
DEMO_PORT=4173
DASHBOARD_ORIGIN=http://127.0.0.1:3000
DEMO_ORIGIN=http://127.0.0.1:4173
COLLECTOR_ORIGIN=http://127.0.0.1:8080
# Create an administrator with pnpm admin create-user (interactive).
# LOCAL_DEMO is the legacy name for the local runtime profile; it does not seed demo sites.
# PRODUCTION requires HTTPS dashboard/collector origins and owner-approved websites.
RELEASE_STATUS=LOCAL_DEMO

# Behind nginx, Caddy or a load balancer set "proxy": the visitor IP comes from X-Forwarded-For
# (rate limits only, never stored). Without it, every visitor shares the proxy's address.
# Set "cloudflare" only when all traffic reaches Infrared through Cloudflare (adds visitor country).
TRUSTED_EDGE=
# Addresses allowed to send those headers, besides loopback.
# Use the trusted proxy's IP addresses or CIDR ranges.
TRUSTED_PROXIES=

# Private directory for logical backups; automatic backup starts OFF.
# Leave empty to use DATA_DIR/backups. Enable the daily schedule in Operations.
HEATMAP_BACKUP_DIR=
# Optional OTLP/HTTP metrics receiver, including /v1/metrics.
# HTTP is accepted only on loopback; use HTTPS for a remote receiver.
# Example: http://127.0.0.1:4318/v1/metrics
# No visitor data is sent to this endpoint. No exporter starts when empty.
HEATMAP_OTEL_METRICS_ENDPOINT=

# Optional on-demand research interpreter; native mode detects .local/predictive-research.
INFRARED_RESEARCH_PYTHON=
# For the optional persistent loopback FastAPI process only. Provision a random shared secret.
INFRARED_RESEARCH_TOKEN=
# Optional worker-side capacity lease shared by warm research processes.
INFRARED_RESEARCH_REDIS=
# Optional paths to local model folders. The default is the output of research/prepare_models.py.
INFRARED_VISION_MODEL=
INFRARED_COPY_MODEL=
# rapidocr uses packaged CPU weights, 1 uses system Tesseract, off skips text extraction.
INFRARED_OCR=rapidocr
